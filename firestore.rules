rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-All Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    // Admin verification: check admins collection or runtime owner email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'aidulbhuinya023@gmail.com'
      );
    }

    // Admins collection: bootstrap and role checks
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Test connection doc for initial boot verification
    match /test/connection {
      allow read: if true;
    }

    // --- User Profiles ---
    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (data.role in ['admin', 'member', 'contributor']);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       (incoming().role != 'admin' || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       (incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin();

      // User favorites subcollection
      match /favorites/{promptId} {
        allow read, write: if isOwner(userId) && isValidId(promptId);
      }
    }

    // --- Prompts Collection ---
    function isValidPrompt(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.promptText is string && data.promptText.size() > 0 && data.promptText.size() <= 10000 &&
             data.category is string && data.category.size() <= 50 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100;
    }

    match /prompts/{promptId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(promptId) &&
                       isValidPrompt(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       (!('isStaffPick' in incoming()) || incoming().isStaffPick == false || isAdmin()) &&
                       (!('isVerified' in incoming()) || incoming().isVerified == false || isAdmin());

      allow update: if isSignedIn() && isValidId(promptId) && (
        // Action 1: Author edits content
        (existing().authorId == request.auth.uid &&
         isValidPrompt(incoming()) &&
         incoming().authorId == existing().authorId &&
         incoming().createdAt == existing().createdAt &&
         incoming().updatedAt == request.time &&
         (!('isStaffPick' in incoming()) || incoming().isStaffPick == existing().isStaffPick) &&
         (!('isVerified' in incoming()) || incoming().isVerified == existing().isVerified) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'title', 'description', 'promptText', 'category', 'targetTools',
           'tags', 'variables', 'systemInstruction', 'temperature',
           'exampleOutput', 'tips', 'updatedAt'
         ])) ||

        // Action 2: Community interaction metrics (copy, favorite counter, rating)
        (incoming().diff(existing()).affectedKeys().hasOnly([
           'copyCount', 'favoritesCount', 'ratingAverage', 'ratingCount', 'updatedAt'
         ]) && incoming().updatedAt == request.time) ||

        // Action 3: Admin curation override
        (isAdmin() &&
         isValidPrompt(incoming()) &&
         incoming().authorId == existing().authorId &&
         incoming().createdAt == existing().createdAt &&
         incoming().updatedAt == request.time)
      );

      allow delete: if isSignedIn() && isValidId(promptId) &&
                       (existing().authorId == request.auth.uid || isAdmin());
    }

    // --- Activity Audit Logs ---
    function isValidActivityLog(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.action is string && (data.action in [
               'create_prompt', 'update_prompt', 'delete_prompt',
               'favorite_prompt', 'test_prompt', 'optimize_prompt',
               'update_branding', 'update_profile'
             ]) &&
             data.timestamp == request.time;
    }

    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(logId) &&
                       isValidActivityLog(incoming());
      // Audit logs are append-only; immutable and cannot be deleted
      allow update, delete: if false;
    }

    // --- Organization Branding & Customization Settings ---
    function isValidBranding(data) {
      return data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 100 &&
             data.primaryColor is string && (data.primaryColor in ['indigo', 'emerald', 'violet', 'sky', 'amber', 'rose']);
    }

    match /settings/branding {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() &&
                               isValidBranding(incoming()) &&
                               incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
