{
  "entities": {
    "User": {
      "title": "User",
      "description": "Company employee profile and preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase user identifier"
        },
        "email": {
          "type": "string",
          "description": "Employee company email address"
        },
        "displayName": {
          "type": "string",
          "description": "Employee full name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "role": {
          "type": "string",
          "description": "Organization role: admin, member, or contributor",
          "enum": ["admin", "member", "contributor"]
        },
        "department": {
          "type": "string",
          "description": "Employee department"
        },
        "themePreference": {
          "type": "string",
          "description": "Selected theme mode",
          "enum": ["dark", "light", "system"]
        },
        "defaultAiTool": {
          "type": "string",
          "description": "Preferred default AI tool filter"
        },
        "emailNotifications": {
          "type": "boolean",
          "description": "Notification preference"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account last updated timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Prompt": {
      "title": "Prompt",
      "description": "Curated organization prompt template",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique prompt ID"
        },
        "title": {
          "type": "string",
          "description": "Prompt title",
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "description": "Brief summary of prompt purpose and expected outcome",
          "maxLength": 500
        },
        "promptText": {
          "type": "string",
          "description": "Complete prompt template body with optional {{variable}} placeholders",
          "maxLength": 10000
        },
        "category": {
          "type": "string",
          "description": "Functional department or use-case category",
          "enum": ["Engineering", "Product", "Marketing", "Sales", "Customer Support", "Legal", "Operations", "HR", "Design", "General"]
        },
        "targetTools": {
          "type": "array",
          "description": "List of AI tools this prompt is tuned for"
        },
        "tags": {
          "type": "array",
          "description": "Categorization tags"
        },
        "variables": {
          "type": "array",
          "description": "Variable placeholder names detected in promptText"
        },
        "systemInstruction": {
          "type": "string",
          "description": "Optional system prompt instruction",
          "maxLength": 3000
        },
        "temperature": {
          "type": "number",
          "description": "Recommended model temperature"
        },
        "exampleOutput": {
          "type": "string",
          "description": "Sample output generated by this prompt",
          "maxLength": 5000
        },
        "tips": {
          "type": "string",
          "description": "Best practices and advice when running this prompt",
          "maxLength": 2000
        },
        "authorId": {
          "type": "string",
          "description": "User UID of prompt creator"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of prompt creator"
        },
        "authorEmail": {
          "type": "string",
          "description": "Email of prompt creator"
        },
        "authorPhotoURL": {
          "type": "string",
          "description": "Avatar URL of author"
        },
        "isStaffPick": {
          "type": "boolean",
          "description": "Whether curated by organization admins"
        },
        "isVerified": {
          "type": "boolean",
          "description": "Verified prompt badge"
        },
        "ratingAverage": {
          "type": "number",
          "description": "Aggregated user rating score"
        },
        "ratingCount": {
          "type": "number",
          "description": "Count of user ratings"
        },
        "favoritesCount": {
          "type": "number",
          "description": "Total user favorites count"
        },
        "copyCount": {
          "type": "number",
          "description": "Total times copied by team members"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp"
        }
      },
      "required": ["title", "promptText", "category", "authorId", "authorName"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit and activity trail for prompt lifecycle events",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Log record ID"
        },
        "userId": {
          "type": "string",
          "description": "User who performed the action"
        },
        "userName": {
          "type": "string",
          "description": "User display name"
        },
        "userEmail": {
          "type": "string",
          "description": "User company email"
        },
        "action": {
          "type": "string",
          "description": "Action performed",
          "enum": ["create_prompt", "update_prompt", "delete_prompt", "favorite_prompt", "test_prompt", "optimize_prompt", "update_branding", "update_profile"]
        },
        "targetId": {
          "type": "string",
          "description": "ID of related target resource"
        },
        "targetTitle": {
          "type": "string",
          "description": "Title or summary of related resource"
        },
        "details": {
          "type": "string",
          "description": "Contextual details or metadata",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of activity"
        }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "CompanyBranding": {
      "title": "CompanyBranding",
      "description": "Organization customization settings and theme scheme",
      "type": "object",
      "properties": {
        "companyName": {
          "type": "string",
          "description": "Name of the organization",
          "maxLength": 100
        },
        "logoUrl": {
          "type": "string",
          "description": "Logo URL or preset avatar icon",
          "maxLength": 500
        },
        "tagline": {
          "type": "string",
          "description": "Company prompt hub tagline",
          "maxLength": 200
        },
        "allowedDomain": {
          "type": "string",
          "description": "Required email domain (e.g. acme.com)",
          "maxLength": 100
        },
        "primaryColor": {
          "type": "string",
          "description": "Brand theme color palette: indigo, emerald, violet, sky, amber, rose",
          "enum": ["indigo", "emerald", "violet", "sky", "amber", "rose"]
        },
        "welcomeMessage": {
          "type": "string",
          "description": "Hero banner welcome message for staff",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of admin who updated branding"
        }
      },
      "required": ["companyName", "primaryColor"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "Prompt starred by a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID"
        },
        "promptId": {
          "type": "string",
          "description": "Prompt ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Favorited timestamp"
        }
      },
      "required": ["userId", "promptId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "User"
      },
      "description": "User profiles and preferences"
    },
    "/prompts/{promptId}": {
      "schema": {
        "$ref": "Prompt"
      },
      "description": "Organization prompts repository"
    },
    "/activityLogs/{logId}": {
      "schema": {
        "$ref": "ActivityLog"
      },
      "description": "Audit log stream of user actions"
    },
    "/settings/branding": {
      "schema": {
        "$ref": "CompanyBranding"
      },
      "description": "Company white-label branding configuration"
    },
    "/users/{userId}/favorites/{promptId}": {
      "schema": {
        "$ref": "UserFavorite"
      },
      "description": "User saved/favorited prompt records"
    }
  }
}
